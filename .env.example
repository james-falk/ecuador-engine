# Neon Postgres connection string. Get one from https://console.neon.tech.
# Uses the pooled endpoint; the @neondatabase/serverless driver handles HTTP transport.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ── Google OAuth (Slice 8: Drive integration) ──────────────────────────
# See scripts/google-oauth-setup.md for step-by-step setup.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Local dev: http://localhost:3009/api/google/callback
# Production: https://<your-vercel-url>/api/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3009/api/google/callback
# Account whose Drive the engine reads (v1 = single account).
GOOGLE_OAUTH_DEFAULT_EMAIL=jamesfalk4@gmail.com
# The Drive folder the engine is locked to. Without this, /drive and
# Companies → Documents render a configuration banner.
ECUADOR_DRIVE_FOLDER_ID=
# AES-256-GCM key for token at-rest encryption. 32 random bytes hex (64 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_KEY=

# ── Email auth (magic link) ────────────────────────────────────────────
# When AUTH_COOKIE_SECRET is set, middleware enforces login. When unset,
# the app stays open. AUTH_COOKIE_SECRET is HMAC-SHA256 key — 64-char hex.
AUTH_COOKIE_SECRET=
# Resend (transactional email). Without this set, magic links print to the
# dev-server console (useful for local testing).
RESEND_API_KEY=
# From address. Use Resend's sandbox sender for dev, your verified domain
# for prod (e.g. "Ecuador Engine <auth@ecuador-engine.com>").
EMAIL_FROM=Ecuador Engine <onboarding@resend.dev>
# Used in magic-link URLs. http://localhost:3009 for local; full deploy
# URL in production.
APP_BASE_URL=http://localhost:3009

# ── Agent ingest (POST /api/intel/ingest) ──────────────────────────────
# Shared bearer token. Any external agent posts daily snapshots with
# `Authorization: Bearer <this value>`. Without it, the endpoint returns
# 503 to prevent unauth'd writes. Generate the same way as OAUTH_TOKEN_KEY.
INTEL_INGEST_TOKEN=

# ── Market-intel agent (USDA AMS source) ───────────────────────────────
# USDA Market News (MARS) API key. Sign up at https://mymarketnews.ams.usda.gov/mars-api
# Used as HTTP Basic username (empty password). Without it the agent
# returns 0 rows from USDA gracefully.
MARS_API_KEY=
# ImportYeti (customs manifest) — paid. Without it the customs source
# returns 0 rows. Optional.
IMPORTYETI_API_KEY=
